{
  "properties": [
    {
      "name": "blog-api.security.enable",
      "type": "java.lang.Boolean",
      "description": "Enable/disable spring security."
    },
    {
      "name": "blog-api.security.jwt.accessSecret",
      "type": "java.lang.String",
      "description": "Access token secret."
    },
    {
      "name": "blog-api.security.jwt.refreshSecret",
      "type": "java.lang.String",
      "description": "Refresh token secret."
    },
    {
      "name": "blog-api.seeding.users.admin-name",
      "type": "java.lang.String",
      "description": "Seeding admin user name."
    },
    {
      "name": "blog-api.seeding.users.admin-email",
      "type": "java.lang.String",
      "description": "Seeding admin user email."
    },
    {
      "name": "blog-api.seeding.users.admin-password",
      "type": "java.lang.String",
      "description": "Seeding admin user password."
    },
    {
      "name": "blog-api.security.cors-allowed-urls",
      "type": "java.lang.String",
      "description": "Seeding admin user password."
    },
    {
      "name": "blog-api.aws.s3.bucket-name",
      "type": "java.lang.String",
      "description": "Name of AWS S3 bucket used to store post images."
    },
    {
      "name": "blog-api.aws.s3.verify-bucket-on-startup",
      "type": "java.lang.Boolean",
      "description": "Whether to verify at startup that the configured S3 bucket exists, failing fast if it does not.",
      "defaultValue": true
    }
  ]
}