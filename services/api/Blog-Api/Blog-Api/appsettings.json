{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "OpenApiOptions": {
    "UiEndpoint": "/scalar"
  },
  "IdentityOptions": {
    "Password": {
      "RequiredLength": 8,
      "RequireLowercase": true,
      "RequireUppercase": true,
      "RequireDigit": true,
      "RequireNonAlphanumeric": false
    },
    "User": {
      "RequireUniqueEmail": true
    }
  }
}
